{
  "name": "talk-with-masahiro",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ma-eguchi/liveavatar-gpt-live-demos.git"
  },
  "description": "AI avatar English coach: Next.js + Supabase app, with a Node orchestrator threading OpenAI GPT-Live into a HeyGen LiveAvatar.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/check-env.mjs && pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "start": "node scripts/check-env.mjs && pnpm --filter server start",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20.12"
  },
  "packageManager": "pnpm@9.0.0"
}

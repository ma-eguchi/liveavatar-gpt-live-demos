# Copy to web/.env.local for local dev. On Vercel, set these in
# Project → Settings → Environment Variables.

# Supabase (Settings → API). Public by design: RLS is the security boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where this backend reaches the orchestrator (server/). Server-only.
ORCHESTRATOR_URL=http://localhost:8787
# Where the BROWSER reaches it for the websocket, if different (e.g. the
# public https URL when ORCHESTRATOR_URL is a private network address).
# ORCHESTRATOR_PUBLIC_URL=
# Same value as ORCHESTRATOR_SECRET in the orchestrator's env. Server-only.
ORCHESTRATOR_SECRET=

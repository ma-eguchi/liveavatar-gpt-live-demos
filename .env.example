# Copy to .env at the repo root. The server reads this file; the browser never
# sees any of it.

# LiveAvatar API key — https://app.liveavatar.com/developers
LIVEAVATAR_API_KEY=

# OpenAI API key. GPT-Live is generally available.
OPENAI_API_KEY=
# GPT_LIVE_MODEL=gpt-live-1

# The default avatar. Swap for any avatar id from your account — or unset it
# and the server picks the first active public avatar (and logs which).
LIVEAVATAR_AVATAR_ID=65f9e3c9-d48b-4118-b73a-4ae2e3cbb8f0

# ── Optional (defaults shown) ────────────────────────────────────────────────
# The persona lives in server/prompts/{instructions,greeting}.md — edit those
# files to change who the avatar is and how it opens.
#
# GPT_LIVE_VOICE=marin              # marin cedar alloy ash ballad coral echo sage shimmer verse
# GPT_LIVE_RESPONSES_MODEL=gpt-5.4-nano  # backend model for delegated turns + tool calls
# GPT_LIVE_DEBUG=1                  # log every GPT-Live event (audio elided) — loud, for debugging
# LIVEAVATAR_API_URL=https://api.liveavatar.com
# PORT=8787

# ── Hosted mode (the Next.js app in web/ talks to this server) ───────────────
# Set ORCHESTRATOR_SECRET to switch the orchestrator from the open local
# starter to hosted mode: /api/session/* then only answer callers presenting
# this secret (the Next.js backend — put the same value in web/.env.local),
# the browser websocket needs a per-session ticket, and session ends are
# written to Supabase. Generate one with: openssl rand -base64 32
ORCHESTRATOR_SECRET=
# Browser origins allowed to open the websocket (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000
# Supabase project URL + service role key (Settings → API). Server-only —
# never put the service role key in web/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Hard cap per session in seconds — the cost ceiling for a public demo.
MAX_SESSION_SECONDS=300
